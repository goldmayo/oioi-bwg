{
  "name": "@oioi-bwg/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build && mkdir -p .next/standalone/apps/console/.next && cp -R .next/static .next/standalone/apps/console/.next/",
    "start": "HOSTNAME=127.0.0.1 PORT=3001 node .next/standalone/apps/console/server.js",
    "lint": "pnpm --dir ../.. exec eslint apps/console && pnpm lint:fsd",
    "lint:fsd": "steiger src --config steiger.config.ts",
    "type-check": "tsc --noEmit --incremental false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@lukemorales/query-key-factory": "1.3.4",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "ky": "^2.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "@oioi-bwg/contracts": "workspace:*",
    "@oioi-bwg/server": "workspace:*",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.14.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "shadcn": "^3.8.5"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
