{
  "name": "@oioi-bwg/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-notification-worker.mjs && next dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/build-notification-worker.mjs && next build && mkdir -p .next/standalone/apps/console/.next && cp -R .next/static .next/standalone/apps/console/.next/ && cp -R public .next/standalone/apps/console/",
    "start": "HOSTNAME=127.0.0.1 PORT=3001 node .next/standalone/apps/console/server.js",
    "lint": "eslint . && pnpm lint:fsd",
    "lint:fsd": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--import tsx\" steiger src --config steiger.config.ts",
    "type-check": "tsc --noEmit --incremental false && tsc --noEmit -p tsconfig.config.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@lukemorales/query-key-factory": "1.3.4",
    "@oioi-bwg/contracts": "workspace:*",
    "@oioi-bwg/server": "workspace:*",
    "@oioi-bwg/ui": "workspace:*",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "^0.7.1",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "firebase": "13.1.0",
    "google-auth-library": "11.1.0",
    "gsap": "^3.14.2",
    "ky": "^2.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "qrcode": "1.5.4",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@oioi-bwg/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.27.3",
    "eslint": "^9",
    "jiti": "2.6.1",
    "jsdom": "^29.0.1",
    "shadcn": "^3.8.5",
    "steiger": "0.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
