{
  "extends": "@oioi-bwg/config/typescript/next.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "types/**/*.d.ts",
    "next-env.d.ts",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "sentry*.config.ts"
  ],
  "exclude": ["node_modules"]
}
