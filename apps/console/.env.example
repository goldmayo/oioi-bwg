# Console은 호스트에서 실행하며 Docker Compose PostgreSQL에 연결합니다.
# 아래 credential은 compose.dev.yml의 로컬 개발 전용 값입니다.
DATABASE_URL=postgresql://oioibawige:oioibawige_dev_only@127.0.0.1:5432/oioibawige

# 로컬에서는 Sentry 전송을 사용하지 않습니다.
NEXT_PUBLIC_APP_ENV=local

# 브라우저에서도 이 주소를 사용하세요. Origin/CSRF 검사가 정확히 비교합니다.
CONSOLE_ORIGIN=http://127.0.0.1:3001

# Console JWT 서명 키. openssl rand -base64 32로 생성해 넣으세요.
# Web AUTH_SECRET 및 아래 MFA 암호화 키와 서로 다른 값을 사용합니다.
CONSOLE_AUTH_SECRET=

# TOTP secret의 AES-256-GCM 암호화 키. 별도로 openssl rand -base64 32 실행.
# 32 bytes의 canonical Base64가 필요합니다. 등록 후 이 값을 계속 보존하세요.
# 키를 바꾸거나 잃으면 기존 인증기 secret을 복호화할 수 없습니다.
CONSOLE_MFA_ENCRYPTION_KEY=

# 최초 QR 등록/재등록을 직접 확인할 때만 true로 변경하세요.
# false는 등록 API/UI를 닫습니다. 이미 등록된 OTP 로그인은 계속 가능합니다.
# 변경 후 dev 서버를 재시작하세요.
CONSOLE_MFA_ENROLLMENT_ENABLED=false
