# .env.example의 값은 비워 두고 실제 값은 개인 .env 또는 .env.local에 입력하세요.
# 개인 파일은 Git에 커밋하지 않습니다.
# 기존 개인 파일은 덮어쓰지 말고 필요한 항목만 반영하세요.

# 실행 환경
# 로컬 개발·production build·검증은 local, VM 배포 입력은 production입니다.
# 허용 값: local | production. NODE_ENV로 배포 환경을 판단하지 않습니다.
NEXT_PUBLIC_APP_ENV=

# 데이터베이스
# 호스트에서는 Compose PostgreSQL의 127.0.0.1:5432/oioibawige에 연결합니다.
# 로컬 credential과 입력 예시는 로컬 개발환경 문서를 확인하세요.
DATABASE_URL=

# 접속·인증
# 로컬 입력 예: http://127.0.0.1:3001. 브라우저에서도 같은 주소를 사용하세요.
# Origin/CSRF 검사가 정확히 비교합니다.
CONSOLE_ORIGIN=

# JWT 서명 키입니다. openssl rand -base64 32로 생성하세요.
# 기존 Web AUTH_SECRET 및 아래 MFA 암호화 키와 서로 다른 값을 사용합니다.
CONSOLE_AUTH_SECRET=

# TOTP secret의 AES-256-GCM 암호화 키입니다. 별도로 openssl rand -base64 32 실행.
# 32 bytes의 canonical Base64가 필요합니다. 등록 후 계속 보존하세요.
# 키를 바꾸거나 잃으면 기존 인증기 secret을 복호화할 수 없습니다.
CONSOLE_MFA_ENCRYPTION_KEY=

# 최초 QR 등록/재등록을 직접 확인할 때만 true로 변경하세요.
# false는 등록 API/UI를 닫으며 이미 등록된 OTP 로그인은 유지합니다.
# 변경 후 dev 서버를 재시작하세요.
CONSOLE_MFA_ENROLLMENT_ENABLED=

# 파일 업로드
# Console만 사용하는 기존 R2 버킷과 서버 전용 키입니다.
# 아래 5개는 dev:console:local 실행 전에 모두 설정해야 합니다.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSETS_PUBLIC_BASE_URL=

# 관측
# 두 앱은 같은 Sentry 프로젝트/DSN을 각각 입력합니다.
# local에서는 DSN이 있어도 Sentry 이벤트를 전송하지 않습니다.
NEXT_PUBLIC_SENTRY_DSN=
