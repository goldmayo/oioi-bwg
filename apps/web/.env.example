# .env.example의 값은 비워 두고 실제 값은 개인 .env 또는 .env.local에 입력하세요.
# 개인 파일은 Git에 커밋하지 않습니다.
# 기존 개인 파일은 덮어쓰지 말고 필요한 항목만 반영하세요.

# 실행 환경
# 로컬 개발·production build·검증은 local, VM 배포 입력은 production입니다.
# 허용 값: local | production. NODE_ENV로 배포 환경을 판단하지 않습니다.
NEXT_PUBLIC_APP_ENV=

# 데이터베이스
# 호스트에서는 Compose PostgreSQL의 127.0.0.1:5432/oioibawige에 연결합니다.
# 로컬 credential과 입력 예시는 로컬 개발환경 문서를 확인하세요.
DATABASE_URL=

# 관측
# 두 앱은 같은 Sentry 프로젝트/DSN을 각각 입력합니다.
# local에서는 DSN이 있어도 Sentry 이벤트를 전송하지 않습니다.
NEXT_PUBLIC_SENTRY_DSN=

# 분석
# 로컬에서는 비워 두세요. 현재 GTM 로드는 NEXT_PUBLIC_APP_ENV로 차단하지 않습니다.
NEXT_PUBLIC_GTM_ID=
