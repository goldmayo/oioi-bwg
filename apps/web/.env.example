# .env.example의 값은 비워 두고 실제 값은 개인 .env.local 한 파일에 입력하세요.
# 개인 파일은 Git에 커밋하지 않습니다.
# 기존 개인 파일은 덮어쓰지 말고 필요한 항목만 반영하세요.
# 일반 Web 실행 입력은 필수 2개(APP_ENV·DB)와 선택 2개(Sentry·GTM)입니다.

# 실행 환경
# 로컬 개발·production build·검증은 local, VM 배포 입력은 production입니다.
# 허용 값: local | production. NODE_ENV로 배포 환경을 판단하지 않습니다.
# 필수: Next dev/build 진입점에서 누락·미지원 값을 거절합니다.
NEXT_PUBLIC_APP_ENV=

# 데이터베이스
# 호스트에서는 Compose PostgreSQL의 127.0.0.1:5432/oioibawige에 연결합니다.
# 로컬 credential과 입력 예시는 로컬 개발환경 문서를 확인하세요.
# 필수: 공개 조회·readyz에서 공용 server 패키지를 통해 읽습니다.
DATABASE_URL=

# 관측
# 두 앱은 같은 Sentry 프로젝트/DSN을 각각 입력합니다.
# local에서는 DSN이 있어도 Sentry 이벤트를 전송하지 않습니다.
# 선택: 빈칸이면 production에서도 Sentry 전송을 사용하지 않습니다.
NEXT_PUBLIC_SENTRY_DSN=

# 분석
# 로컬에서는 비워 두세요. 현재 GTM 로드는 NEXT_PUBLIC_APP_ENV로 차단하지 않습니다.
# 선택: 값이 있을 때만 root layout에서 Google Tag Manager를 로드합니다.
NEXT_PUBLIC_GTM_ID=

# 선택 빌드 입력: Sentry 소스맵 게시
# 일반 로컬 실행에서는 모두 비워 둡니다. CI가 명시적으로 게시할 때만 사용합니다.
# SENTRY_SOURCE_MAPS_ENABLED=true이면 아래 token·org·project·release가 모두 필수입니다.
# token은 빌드 비밀값이며 Docker에서는 BuildKit secret으로 주입합니다.
# release 형식: oioi-bwg@<소문자 40자리 Git SHA>.
SENTRY_SOURCE_MAPS_ENABLED=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# 선택 빌드 입력: 캐시 제어
# true이면 Turbopack 파일시스템 빌드 캐시를 끕니다. 일반 로컬에서는 비워 둡니다.
OIOI_EPHEMERAL_BUILD=

# NODE_ENV·NEXT_RUNTIME은 Next 실행 정보입니다. 개인 배포 환경값으로 입력하지 않습니다.
# 현재 Web은 R2 업로드·인증·메일 환경변수를 읽지 않습니다.
# 기존 값이 있으면 .env.local의 보존 설정 그룹에 남기세요.
