# Web is public read-only. Auth, mail delivery and R2 upload have no active Web consumer.
# Existing private env files and host rollback mappings are preserved separately.
DATABASE_URL=postgresql://oioibawige:oioibawige_dev_only@127.0.0.1:5432/oioibawige

# Public build-time environment. Local mode never sends Sentry events.
NEXT_PUBLIC_APP_ENV=local
# Shared Sentry project DSN. Each app owns its own env input.
NEXT_PUBLIC_SENTRY_DSN=

# Album image upload settings belong to apps/console/.env.local.
