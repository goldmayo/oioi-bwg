    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.14.2",
    "ky": "^2.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
