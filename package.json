{
  "name": "cheer-rock-crab",
  "version": "0.7.1",
  "packageManager": "pnpm@10.15.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @oioi-bwg/web dev",
    "build": "turbo run build",
    "start": "pnpm --filter @oioi-bwg/web start",
    "lint": "turbo run lint --filter=!@oioi-bwg/repository-tools && pnpm lint:repo && pnpm lint:deps",
    "lint:fsd": "pnpm --filter @oioi-bwg/web --filter @oioi-bwg/console lint:fsd",
    "type-check": "turbo run type-check --filter=!@oioi-bwg/repository-tools && pnpm type-check:repo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "turbo run type-check lint test --filter=!@oioi-bwg/repository-tools && pnpm type-check:repo && pnpm lint:repo && pnpm lint:deps && pnpm test:harness && pnpm test:ops && pnpm format:check && turbo run build",
    "prepare": "husky",
    "db:generate": "node --import tsx -- scripts/run-local-database-tool.ts generate",
    "db:plan-uuid": "node --conditions=react-server --import tsx scripts/plan-uuid-cutover.ts",
    "db:migrate": "node --import tsx -- scripts/run-local-database-tool.ts migrate",
    "db:restore-local": "sh scripts/restore-local-dump.sh",
    "db:configure-runtime-roles": "tsx scripts/configure-postgres-runtime-roles.ts",
    "db:pull": "node --import tsx -- scripts/run-local-database-tool.ts pull",
    "db:studio": "node --import tsx -- scripts/run-local-database-tool.ts studio",
    "build:console-operator": "node scripts/build-console-operator.mjs",
    "console:mfa": "node --conditions=react-server --import tsx scripts/console-mfa-operator.ts",
    "console:bootstrap": "node --conditions=react-server --import tsx scripts/console-admin-bootstrap.ts",
    "test:coverage": "vitest run --coverage",
    "test:integration:postgres": "tsx scripts/run-postgres-integration-tests.ts",
    "test:integration:postgres:local": "docker compose -f compose.dev.yml up -d --wait postgres && tsx scripts/run-postgres-integration-tests.ts --local",
    "test:load": "K6_WEB_DASHBOARD=true k6 run -e BASE_URL=https://staging.oioibawige.com tests/k6/load.js",
    "test:ops": "vitest run --config tests/ops/vitest.config.ts",
    "test:unit": "vitest",
    "test:unit:run": "turbo run test",
    "test:harness": "pnpm --filter @oioi-bwg/repository-tools test:harness",
    "test:stress": "K6_WEB_DASHBOARD=true k6 run -e BASE_URL=https://staging.oioibawige.com tests/k6/stress.js",
    "test:spike": "K6_WEB_DASHBOARD=true k6 run -e BASE_URL=https://staging.oioibawige.com tests/k6/spike.js",
    "lint:repo": "eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"tools/**\" && pnpm --filter @oioi-bwg/repository-tools lint",
    "type-check:repo": "tsc --noEmit -p tsconfig.json && pnpm type-check:config && pnpm type-check:scripts && tsc --noEmit -p tests/tsconfig.json && pnpm --filter @oioi-bwg/repository-tools type-check",
    "type-check:tests": "tsc --noEmit -p tests/tsconfig.json && pnpm --filter @oioi-bwg/repository-tools type-check:tests",
    "dev:console": "pnpm --filter @oioi-bwg/console dev",
    "dev:console:local": "tsx scripts/dev-console-local.mts",
    "test:integration:admin": "tsx scripts/run-postgres-integration-tests.ts --admin-smoke",
    "test:integration:admin:local": "docker compose -f compose.dev.yml up -d --wait postgres && tsx scripts/run-postgres-integration-tests.ts --local --admin-smoke",
    "type-check:config": "tsc --noEmit -p tsconfig.config.json",
    "type-check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint:deps": "pnpm --filter @oioi-bwg/repository-tools lint:deps && turbo boundaries",
    "db:import-guides": "node --conditions=react-server --import tsx scripts/import-cheer-guides.ts",
    "waveform:generate": "tsx scripts/generate-waveform.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "husky": "^9.1.7",
    "jiti": "2.6.1",
    "jsdom": "^29.0.1",
    "jsqr": "1.4.0",
    "lint-staged": "^16.3.1",
    "playwright": "^1.62.1",
    "pngjs": "7.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "steiger": "0.6.0",
    "tsx": "^4.21.0",
    "turbo": "2.11.7",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
