# Local host-run defaults. compose.dev.yml overrides DATABASE_URL inside the Next container.
NEXT_PUBLIC_APP_ENV=local
DATABASE_URL=postgresql://oioibawige:oioibawige_dev_only@localhost:5432/oioibawige

# Supabase Auth remains remote during migration. Fill these from the team secret store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_ASSETS_URL=https://assets.oioibawige.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_GTM_ID=
