# R2 album image upload. Access key and secret are server-only runtime secrets.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSETS_PUBLIC_BASE_URL=https://assets.oioibawige.com

# Auth.js JWT signing secret. Generate a unique value per environment.
AUTH_SECRET=

# Email Delivery: local/test defaults to dev (no external send). Production must use OCI.
EMAIL_DELIVERY_MODE=dev
OCI_EMAIL_REGION=
OCI_EMAIL_COMPARTMENT_OCID=
OCI_EMAIL_SENDER_ADDRESS=
OCI_EMAIL_SENDER_NAME=
