# Non-secret host deployment configuration. Install as /etc/oioibawige/deploy.conf (0600).
IMAGE_REPOSITORY=ap-osaka-1.ocir.io/<namespace>/<repository>
POSTGRES_NETWORK=<existing-postgresql-docker-network>
DATABASE_HOST=<postgres-container-dns>
DATABASE_PORT=5432
DATABASE_NAME=<database>
DATABASE_USER=oioi_app
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
SMOKE_PATHS="/ /api/auth/session"
REQUIRED_RUNTIME_KEYS="DATABASE_URL AUTH_SECRET"

# Instance Principal operations and custom metric dimensions.
OCI_REGION=ap-osaka-1
OCI_METRIC_COMPARTMENT_OCID=ocid1.compartment.oc1..<compute-compartment>
OCI_COMPUTE_INSTANCE_OCID=ocid1.instance.oc1.ap-osaka-1.<unique-id>
