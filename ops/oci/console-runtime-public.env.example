# Separate Console configuration; installed only by the approved paired-host upgrade.
CONSOLE_ORIGIN=http://127.0.0.1:3001
CONSOLE_MFA_ENROLLMENT_ENABLED=false
CONSOLE_PUSH_ENABLED=false
# Enable only after project/VAPID/server permission and real receipt verification.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_VAPID_PUBLIC_KEY=
# Required Console upload settings; preserve the existing bucket and assets domain.
R2_ENDPOINT=
R2_BUCKET=
ASSETS_PUBLIC_BASE_URL=https://assets.oioibawige.com
