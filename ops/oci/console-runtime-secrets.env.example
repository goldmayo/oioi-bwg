# Existing Vault secret IDs only. Never put values here or regenerate Auth/MFA keys.
DB_APP_PASSWORD=ocid1.vaultsecret.<region>.<existing-app-password-id>
CONSOLE_AUTH_SECRET=ocid1.vaultsecret.<region>.<existing-console-auth-id>
CONSOLE_MFA_ENCRYPTION_KEY=ocid1.vaultsecret.<region>.<existing-console-mfa-id>
R2_ACCESS_KEY_ID=ocid1.vaultsecret.<region>.<existing-r2-access-key-id>
R2_SECRET_ACCESS_KEY=ocid1.vaultsecret.<region>.<existing-r2-secret-access-key>
# Optional Console-only service account JSON, one line in Vault.
# FIREBASE_SERVICE_ACCOUNT_JSON=ocid1.vaultsecret.<region>.<console-fcm-id>

# Runner 활성화 시에만 추가한다. Runner와 동일한 기존 Vault secret OCID.
# CONSOLE_WAVEFORM_RUNNER_TOKEN=ocid1.vaultsecret.<region>.<existing-waveform-runner-id>
