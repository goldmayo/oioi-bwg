# Non-secret mapping from application environment names to OCI Vault secret OCIDs.
# Install as /etc/oioibawige/runtime-secrets.env with mode 0600.
DB_APP_PASSWORD=ocid1.vaultsecret.<region>.<unique-id>
AUTH_SECRET=ocid1.vaultsecret.<region>.<unique-id>
R2_ACCESS_KEY_ID=ocid1.vaultsecret.<region>.<unique-id>
R2_SECRET_ACCESS_KEY=ocid1.vaultsecret.<region>.<unique-id>
