# Compose interpolation only. Materialize as /srv/oioibawige/release.env on the OCI instance.
# Deployment identity must be an OCIR manifest digest, never a mutable tag.
APP_IMAGE=ap-osaka-1.ocir.io/<namespace>/<repository>@sha256:<64-hex-digest>
POSTGRES_NETWORK=<existing-postgresql-docker-network>
APP_ENV_FILE=/srv/oioibawige/app.env
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
