{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": "node_modules/.cache/turbo",
  "tasks": {
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/node.json",
        "$TURBO_ROOT$/packages/config/eslint/**"
      ],
      "outputs": [],
      "dependsOn": ["^transit"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/eslint/**"
      ],
      "outputs": [],
      "dependsOn": ["^transit"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts"
      ],
      "outputs": [],
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/next.ts",
        "$TURBO_ROOT$/packages/config/sentry-build.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/next.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"],
      "env": [
        "NODE_ENV",
        "OIOI_EPHEMERAL_BUILD",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_SOURCE_MAPS_ENABLED"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts"
      ],
      "outputs": []
    },
    "@oioi-bwg/config#transit": {
      "dependsOn": [],
      "inputs": ["package.json"],
      "outputs": []
    },
    "@oioi-bwg/config#build": {
      "dependsOn": [],
      "inputs": ["package.json"],
      "outputs": []
    },
    "@oioi-bwg/web#type-check": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/node.json",
        "$TURBO_ROOT$/packages/config/eslint/**",
        "$TURBO_ROOT$/packages/config/typescript/next.json",
        "$TURBO_ROOT$/packages/config/next.ts",
        "$TURBO_ROOT$/packages/config/sentry-build.ts",
        "$TURBO_ROOT$/packages/config/steiger.ts",
        "$TURBO_ROOT$/packages/config/vitest/browser.js",
        "$TURBO_ROOT$/packages/config/vitest/postgres.js"
      ],
      "outputs": []
    },
    "@oioi-bwg/web#lint": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/eslint/**",
        "$TURBO_ROOT$/packages/config/steiger.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/next.json"
      ],
      "outputs": []
    },
    "@oioi-bwg/web#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/vitest/browser.js",
        "$TURBO_ROOT$/packages/config/vitest/browser.setup.ts",
        "$TURBO_ROOT$/packages/config/vitest/server-only.ts",
        "$TURBO_ROOT$/packages/config/vitest/client-only.ts"
      ],
      "outputs": []
    },
    "@oioi-bwg/console#type-check": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/node.json",
        "$TURBO_ROOT$/packages/config/eslint/**",
        "$TURBO_ROOT$/packages/config/typescript/next.json",
        "$TURBO_ROOT$/packages/config/next.ts",
        "$TURBO_ROOT$/packages/config/sentry-build.ts",
        "$TURBO_ROOT$/packages/config/steiger.ts",
        "$TURBO_ROOT$/packages/config/vitest/browser.js",
        "$TURBO_ROOT$/packages/config/vitest/postgres.js"
      ],
      "outputs": []
    },
    "@oioi-bwg/console#lint": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/eslint/**",
        "$TURBO_ROOT$/packages/config/steiger.ts",
        "$TURBO_ROOT$/packages/config/typescript/base.json",
        "$TURBO_ROOT$/packages/config/typescript/next.json"
      ],
      "outputs": []
    },
    "@oioi-bwg/console#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/vitest/browser.js",
        "$TURBO_ROOT$/packages/config/vitest/browser.setup.ts",
        "$TURBO_ROOT$/packages/config/vitest/server-only.ts",
        "$TURBO_ROOT$/packages/config/vitest/client-only.ts"
      ],
      "outputs": []
    },
    "@oioi-bwg/server#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.next/**",
        "!**/.turbo/**",
        "!*.tsbuildinfo",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts",
        "$TURBO_ROOT$/packages/config/vitest/server-only.ts"
      ],
      "outputs": []
    },
    "@oioi-bwg/repository-tools#type-check": {
      "dependsOn": ["^transit"],
      "cache": false,
      "outputs": []
    },
    "@oioi-bwg/repository-tools#lint": {
      "dependsOn": ["^transit"],
      "cache": false,
      "outputs": []
    }
  }
}
