{
  "name": "@oioi-bwg/repository-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint": "./eslint.config.ts",
    "./steiger": "./steiger.config.ts",
    "./typescript/repository.json": "./typescript/repository.json",
    "./cli/dependencies": "./src/check-workspace-dependencies.ts",
