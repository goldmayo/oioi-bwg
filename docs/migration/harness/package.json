{
  "name": "auto_factory_ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:lan": "vite dev --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "api:check": "node scripts/api-check.mjs",
    "spec:coverage": "node scripts/spec-coverage.mjs",
    "spec:ids": "node scripts/spec-id-baseline.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:fsd && npm test",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --check",
    "analyze": "vite build --mode analyze",
    "scan": "react-scan http://localhost:3000",
    "prepare": "husky"
  },
