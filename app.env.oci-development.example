# Runtime values only. OCI Secret Management is the SSOT; the deploy process
# materializes /srv/oioibawige/app.env with mode 0600. Never edit or commit it.
DATABASE_URL=postgresql://<application-user>:<password>@<postgres-container-dns>:5432/<database>
AUTH_SECRET=<auth-secret>

# These public values must agree with the values baked into the staging image.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# R2 album image upload. Leave unavailable only when upload smoke is intentionally deferred.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSETS_PUBLIC_BASE_URL=https://assets.oioibawige.com

# Keep external email disabled until the OCI development smoke explicitly tests it.
EMAIL_DELIVERY_MODE=dev
OCI_EMAIL_REGION=
OCI_EMAIL_COMPARTMENT_OCID=
OCI_EMAIL_SENDER_ADDRESS=
OCI_EMAIL_SENDER_NAME=
