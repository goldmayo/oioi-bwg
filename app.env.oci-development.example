# Non-secret server runtime values only. Install as /etc/oioibawige/runtime-public.env.
# The deploy process combines these values with OCI Secret Management values
# into /srv/oioibawige/app.env (0600). DATABASE_URL is assembled from the
# oioi_app password and database coordinates in deploy.conf.
# NEXT_PUBLIC_* values are image build inputs managed by the GitHub environment.

# R2 album image upload. Leave unavailable only when upload smoke is intentionally deferred.
R2_ENDPOINT=
R2_BUCKET=
ASSETS_PUBLIC_BASE_URL=https://assets.oioibawige.com

# Keep external email disabled until the OCI development smoke explicitly tests it.
EMAIL_DELIVERY_MODE=dev
OCI_EMAIL_REGION=
OCI_EMAIL_COMPARTMENT_OCID=
OCI_EMAIL_SENDER_ADDRESS=
OCI_EMAIL_SENDER_NAME=
