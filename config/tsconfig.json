{
  "extends": "@oioi-bwg/config/typescript/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "../eslint.config.ts",
    "../drizzle.config.ts",
    "../steiger.config.ts",
    "../vitest.config.ts",
    "../vitest.ops.config.ts",
    "../vitest.postgres.config.ts",
    "../apps/*/vitest.config.ts",
    "../apps/*/vitest.postgres.config.ts",
    "../apps/*/next.config.ts",
    "../packages/*/vitest.config.ts",
    "../apps/*/eslint.config.ts",
    "../apps/*/steiger.config.ts",
    "../apps/*/eslint/*.ts",
    "../packages/*/eslint.config.ts"
  ]
}
