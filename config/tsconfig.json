{
  "extends": "./typescript/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": false
  },
  "include": [
    "./**/*.ts",
    "../eslint.config.ts",
    "../steiger.config.ts",
    "../vitest.config.ts",
    "../apps/*/vitest.config.ts",
    "../packages/*/vitest.config.ts",
    "../apps/*/eslint.config.ts",
    "../apps/*/steiger.config.ts",
    "../apps/*/eslint/*.ts",
    "../packages/*/eslint.config.ts",
    "../harness/architecture/*.ts"
  ]
}
